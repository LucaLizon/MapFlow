  .color-swatch-container.selected {
    border-color: #4F46E5 !important;
    background: #EDF0F3 !important;
  }
  
  #remove-color-btn:hover {
    background: #FEE2E2 !important;
  }
  
  #remove-color-btn.selected {
    border-color: #EF4444 !important;
    background: #FEE2E2 !important;
  }
</style>

<script>
(function() {
  console.log('[ColorPalette] Initializing 10×7 palette (horizontal layout)');
  
  setTimeout(function() {
    const containers = document.querySelectorAll('#color-palette-container .color-swatch-container');
    const removeBtn = document.getElementById('remove-color-btn');
    
    console.log('[ColorPalette] Found', containers.length, 'color swatches');
    
    // ✅ Fonction pour mettre à jour l'indicateur topbar
    function updateTopbarIndicator(color) {
      const indicator = document.getElementById('fill-color-indicator');
      if (indicator) {
        indicator.style.backgroundColor = color;
        console.log('[ColorPalette] ✓ Topbar updated to:', color);
      } else {
        console.warn('[ColorPalette] ⚠ Indicator not found');
      }
    }
    
    if (removeBtn) {
      removeBtn.addEventListener('click', function() {
        console.log('[ColorPalette] Remove color selected');
        
        document.querySelectorAll('.color-swatch-container').forEach(c => c.classList.remove('selected'));
        document.querySelectorAll('.custom-color-swatch-container').forEach(c => {
          c.classList.remove('selected');
          c.style.borderColor = 'transparent';
          c.style.background = 'transparent';
        });
        
        this.classList.add('selected');
        
        // Mettre à jour l'indicateur topbar avec transparent
        updateTopbarIndicator('transparent');
        
        if (window.mapFunctions && window.mapFunctions.applyColorToSelected) {
          window.mapFunctions.applyColorToSelected('transparent');
        }
      });
    }
    
    containers.forEach(container => {
      if (container.id === 'remove-color-btn') return;
      
      container.addEventListener('click', function() {
        const color = this.getAttribute('data-color');
        if (!color) return;
        
        console.log('[ColorPalette] Color selected:', color);
        
        document.querySelectorAll('.color-swatch-container').forEach(c => c.classList.remove('selected'));
        document.querySelectorAll('.custom-color-swatch-container').forEach(c => {
          c.classList.remove('selected');
          c.style.borderColor = 'transparent';
          c.style.background = 'transparent';
        });
        
        this.classList.add('selected');
        
        // Mettre à jour l'indicateur topbar
        updateTopbarIndicator(color);
        
        if (window.mapFunctions && window.mapFunctions.applyColorToSelected) {
          window.mapFunctions.applyColorToSelected(color);
        }
      });
    });
    
    console.log('[ColorPalette] ✓ Initialization complete');
  }, 300);
})();
</script>