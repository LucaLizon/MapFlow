    '#D32F2F', '#F57C00', '#FBC02D', '#388E3C', '#0097A7', '#1976D2', '#303F9F', '#7B1FA2', '#C2185B', '#5D4037',
    '#B71C1C', '#E65100', '#F57F17', '#1B5E20', '#006064', '#0D47A1', '#1A237E', '#4A148C', '#880E4F', '#3E2723'
  ];

  var STORAGE_KEY = 'mapflow_custom_colors';
  var currentStrokeType = 'solid';
  var currentThickness = 20;
  var currentSpacing = 10;

  // ===== DRAG FUNCTIONALITY =====
  var isDragging = false;
  var dragStartX = 0;
  var dragStartValue = 0;
  var dragTarget = null;
  var dragIcon = null;
  var dragSensitivity = 0.2;

  function initDrag(icon) {
    icon.addEventListener('mousedown', function(e) {
      e.preventDefault();
      isDragging = true;
      dragStartX = e.clientX;
      dragIcon = icon;
      dragTarget = document.getElementById(icon.getAttribute('data-target'));
      dragStartValue = parseInt(dragTarget.value) || 0;
      
      icon.classList.add('dragging');
      document.body.style.cursor = 'ew-resize';
      document.body.style.userSelect = 'none';
    });
  }

  document.addEventListener('mousemove', function(e) {
    if (!isDragging || !dragTarget) return;
    
    var deltaX = e.clientX - dragStartX;
    var deltaValue = Math.round(deltaX * dragSensitivity);
    var newValue = Math.max(0, Math.min(100, dragStartValue + deltaValue));
    
    dragTarget.value = newValue;
    
    if (dragTarget.id === 'scm-thickness-input') {
      currentThickness = newValue;
      if (window.mapFunctions && window.mapFunctions.applyStrokeThickness) {
        window.mapFunctions.applyStrokeThickness(currentThickness);
      }
    } else if (dragTarget.id === 'scm-spacing-input') {
      currentSpacing = newValue;
      if (window.mapFunctions && window.mapFunctions.applyStrokeSpacing) {
        window.mapFunctions.applyStrokeSpacing(currentSpacing);
      }
    }
  });

  document.addEventListener('mouseup', function() {
    if (isDragging) {
      isDragging = false;
      if (dragIcon) dragIcon.classList.remove('dragging');
      document.body.style.cursor = '';
      document.body.style.userSelect = '';
      dragTarget = null;
      dragIcon = null;
    }
  });

  var thicknessIcon = document.getElementById('scm-thickness-icon');
  var spacingIcon = document.getElementById('scm-spacing-icon');
  if (thicknessIcon) initDrag(thicknessIcon);
  if (spacingIcon) initDrag(spacingIcon);

  // ===== COULEURS =====
  function loadCustomColors() {
    try {
      var stored = localStorage.getItem(STORAGE_KEY);
      return stored ? JSON.parse(stored) : [];
    } catch (e) {
      return [];
    }
  }

  function renderPalette() {
    var grid = document.getElementById('scm-palette-grid');
    if (!grid) return;
    
    grid.innerHTML = '';
    
    PALETTE_COLORS.forEach(function(color) {
      var container = document.createElement('div');
      container.className = 'scm-color-swatch-container';
      
      if (color === 'remove') {
        container.classList.add('remove-color');
        container.innerHTML = '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#EF4444" stroke-width="2"><line x1="3" y1="3" x2="21" y2="21"/><line x1="21" y1="3" x2="3" y2="21"/></svg>';
        container.addEventListener('click', function() { selectColor('transparent', container); });
      } else {
        container.innerHTML = '<div class="scm-color-swatch" style="background: ' + color + ';"></div>';
        container.addEventListener('click', function() { selectColor(color, container); });
      }
      
      grid.appendChild(container);
    });
  }

  function renderCustomColors() {
    var wrapper = document.getElementById('scm-custom-colors-wrapper');
    if (!wrapper) return;
    
    wrapper.innerHTML = '';
    var customColors = loadCustomColors();
    
    customColors.forEach(function(colorObj, index) {
      var container = document.createElement('div');
      container.className = 'scm-custom-color-container';
      container.innerHTML = '<div class="scm-custom-color-swatch" style="background: ' + colorObj.hex + ';"></div><div class="scm-custom-delete"><svg viewBox="0 0 8 8" fill="none"><path d="M1 1L7 7M7 1L1 7" stroke="white" stroke-width="1.5" stroke-linecap="round"/></svg></div>';
      
      container.addEventListener('click', function(e) {
        if (!e.target.closest('.scm-custom-delete')) {
          selectColor(colorObj.hex, container);
        }
      });
      
      var deleteBtn = container.querySelector('.scm-custom-delete');
      deleteBtn.addEventListener('click', function(e) {
        e.stopPropagation();
        deleteCustomColor(index);
      });
      
      wrapper.appendChild(container);
    });
    
    // Bouton + (ouvre seulement, pas de toggle)
    var addBtn = document.createElement('button');
    addBtn.className = 'scm-add-color-btn';
    addBtn.innerHTML = '<div class="scm-add-color-inner"><svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M11 13H5V11H11V5H13V11H19V13H13V19H11V13Z" fill="white"/></svg></div>';
    addBtn.addEventListener('click', function(e) {
      e.preventDefault();
      e.stopPropagation();
      if (window.openColorPicker) {
        window.openColorPicker('stroke-color-menu');
      }
    });
    wrapper.appendChild(addBtn);
  }
  
  window.scmRenderCustomColors = renderCustomColors;

  function deleteCustomColor(index) {
    var stored = localStorage.getItem(STORAGE_KEY);
    var colors = stored ? JSON.parse(stored) : [];
    colors.splice(index, 1);
    localStorage.setItem(STORAGE_KEY, JSON.stringify(colors));
    renderCustomColors();
    window.dispatchEvent(new CustomEvent('customColorAdded'));
  }

  function selectColor(color, element) {
    document.querySelectorAll('.scm-color-swatch-container, .scm-custom-color-container').forEach(function(el) {
      el.classList.remove('selected');
    });
    
    if (element) element.classList.add('selected');
    
    var indicator = document.getElementById('stroke-color-indicator');
    if (indicator) {
      if (color === 'transparent') {
        indicator.style.background = 'white';
        indicator.innerHTML = '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#EF4444" stroke-width="2" style="display:block;margin:auto;"><line x1="3" y1="3" x2="21" y2="21"/><line x1="21" y1="3" x2="3" y2="21"/></svg>';
      } else {
        indicator.style.background = color;
        indicator.innerHTML = '';
      }
    }
    
    if (window.mapFunctions && window.mapFunctions.applyStrokeColorToSelected) {
      window.mapFunctions.applyStrokeColorToSelected(color);
    }
  }

  // ===== STROKE TYPE SELECTION =====
  document.querySelectorAll('.scm-stroke-type').forEach(function(btn) {
    btn.addEventListener('click', function() {
      document.querySelectorAll('.scm-stroke-type').forEach(function(b) { 
        b.classList.remove('active');
        var rect = b.querySelector('rect');
        if (rect) rect.setAttribute('fill', '#F5F5F5');
      });
      this.classList.add('active');
      var rect = this.querySelector('rect');
      if (rect) rect.setAttribute('fill', 'white');
      currentStrokeType = this.getAttribute('data-stroke');
      
      if (window.mapFunctions && window.mapFunctions.applyStrokeType) {
        window.mapFunctions.applyStrokeType(currentStrokeType);
      }
    });
  });

  // ===== INPUT HANDLERS =====
  var thicknessInput = document.getElementById('scm-thickness-input');
  if (thicknessInput) {
    thicknessInput.addEventListener('change', function() {
      currentThickness = Math.max(0, Math.min(100, parseInt(this.value) || 0));
      this.value = currentThickness;
      if (window.mapFunctions && window.mapFunctions.applyStrokeThickness) {
        window.mapFunctions.applyStrokeThickness(currentThickness);
      }
    });
  }

  var spacingInput = document.getElementById('scm-spacing-input');
  if (spacingInput) {
    spacingInput.addEventListener('change', function() {
      currentSpacing = Math.max(0, Math.min(100, parseInt(this.value) || 0));
      this.value = currentSpacing;
      if (window.mapFunctions && window.mapFunctions.applyStrokeSpacing) {
        window.mapFunctions.applyStrokeSpacing(currentSpacing);
      }
    });
  }

  // ===== TABS =====
  document.querySelectorAll('.scm-tab').forEach(function(tab) {
    tab.addEventListener('click', function() {
      document.querySelectorAll('.scm-tab').forEach(function(t) { t.classList.remove('active'); });
      this.classList.add('active');
    });
  });

  // ===== CLOSE BUTTON =====
  document.getElementById('scm-close-btn').addEventListener('click', function(e) {
    e.stopPropagation();
    
    if (window.closeColorPicker) {
      window.closeColorPicker();
    }
    
    setTimeout(function() {
      var clickEvent = new MouseEvent('click', {
        bubbles: true,
        cancelable: true,
        view: window,
        clientX: 0,
        clientY: 0
      });
      document.body.dispatchEvent(clickEvent);
    }, 10);
  });

  // ===== OBSERVER pour fermer le Color Picker quand SCM se ferme =====
  var scmObserver = new MutationObserver(function(mutations) {
    mutations.forEach(function(mutation) {
      if (mutation.type === 'attributes') {
        var menu = document.getElementById('stroke-color-menu');
        var groupFocus = menu ? menu.closest('[class*="group-focus"], [class*="GroupFocus"]') : null;
        
        if (groupFocus) {
          var isHidden = groupFocus.style.display === 'none' || 
                        window.getComputedStyle(groupFocus).display === 'none';
          
          if (isHidden) {
            var panel = document.getElementById('custom-color-panel');
            if (panel) {
              panel.classList.remove('open');
              panel.style.display = 'none';
            }
          }
        }
      }
    });
  });

  setTimeout(function() {
    var menu = document.getElementById('stroke-color-menu');
    var groupFocus = menu ? menu.closest('[class*="group-focus"], [class*="GroupFocus"]') : null;
    if (groupFocus) {
      scmObserver.observe(groupFocus, { attributes: true, attributeFilter: ['style'] });
      console.log('[SCM] Observer attached to GroupFocus');
    }
  }, 100);
  
  // ===== EVENT LISTENERS =====
  window.addEventListener('customColorAdded', function() {
    renderCustomColors();
  });

  // ===== INIT =====
  renderPalette();
  renderCustomColors();
  console.log('[SCM] ✓ Initialized');
})();
</script>
