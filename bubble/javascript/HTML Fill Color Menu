<script>
(function() {
  console.log('[FCM] Starting...');
  
  const PALETTE_COLORS = [
    'remove', '#FFFFFF', '#F5F5F5', '#E5E7EB', '#BDBDBD', '#9E9E9E', '#757575', '#616161', '#424242', '#212121',
    '#FFCDD2', '#FFE0B2', '#FFF9C4', '#C8E6C9', '#B2EBF2', '#BBDEFB', '#C5CAE9', '#E1BEE7', '#F8BBD0', '#D7CCC8',
    '#EF9A9A', '#FFCC80', '#FFF59D', '#A5D6A7', '#80DEEA', '#90CAF9', '#9FA8DA', '#CE93D8', '#F06292', '#BCAAA4',
    '#E57373', '#FFB74D', '#FFF176', '#81C784', '#4DD0E1', '#64B5F6', '#7986CB', '#BA68C8', '#EC407A', '#A1887F',
    '#F44336', '#FF9800', '#FFEB3B', '#4CAF50', '#00BCD4', '#2196F3', '#3F51B5', '#9C27B0', '#E91E63', '#795548',
    '#D32F2F', '#F57C00', '#FBC02D', '#388E3C', '#0097A7', '#1976D2', '#303F9F', '#7B1FA2', '#C2185B', '#5D4037',
    '#B71C1C', '#E65100', '#F57F17', '#1B5E20', '#006064', '#0D47A1', '#1A237E', '#4A148C', '#880E4F', '#3E2723'
  ];

  const STORAGE_KEY = 'mapflow_custom_colors';

  function loadCustomColors() {
    try {
      const stored = localStorage.getItem(STORAGE_KEY);
      return stored ? JSON.parse(stored) : [];
    } catch (e) {
      return [];
    }
  }

  function saveCustomColors(colors) {
    localStorage.setItem(STORAGE_KEY, JSON.stringify(colors));
  }

  function renderPalette() {
    const grid = document.getElementById('fcm-palette-grid');
    if (!grid) return;
    
    grid.innerHTML = '';
    
    PALETTE_COLORS.forEach(function(color) {
      const container = document.createElement('div');
      container.className = 'fcm-color-swatch-container';
      
      if (color === 'remove') {
        container.classList.add('remove-color');
        container.innerHTML = '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#EF4444" stroke-width="2"><line x1="3" y1="3" x2="21" y2="21"/><line x1="21" y1="3" x2="3" y2="21"/></svg>';
        container.addEventListener('click', function() { selectColor('transparent', container); });
      } else {
        container.innerHTML = '<div class="fcm-color-swatch" style="background: ' + color + ';"></div>';
        container.addEventListener('click', function() { selectColor(color, container); });
      }
      
      grid.appendChild(container);
    });
    console.log('[FCM] Palette rendered');
  }

  function renderCustomColors() {
    const wrapper = document.getElementById('fcm-custom-colors-wrapper');
    if (!wrapper) {
      console.error('[FCM] Wrapper not found');
      return;
    }
    
    wrapper.innerHTML = '';
    const customColors = loadCustomColors();
    
    customColors.forEach(function(colorObj, index) {
      const container = document.createElement('div');
      container.className = 'fcm-custom-color-container';
      container.innerHTML = '<div class="fcm-custom-color-swatch" style="background: ' + colorObj.hex + ';"></div><div class="fcm-custom-delete"><svg viewBox="0 0 8 8" fill="none"><path d="M1 1L7 7M7 1L1 7" stroke="white" stroke-width="1.5" stroke-linecap="round"/></svg></div>';
      
      container.addEventListener('click', function(e) {
        if (!e.target.closest('.fcm-custom-delete')) {
          selectColor(colorObj.hex, container);
        }
      });
      
      var deleteBtn = container.querySelector('.fcm-custom-delete');
      deleteBtn.addEventListener('click', function(e) {
        e.stopPropagation();
        deleteCustomColor(index);
      });
      
      wrapper.appendChild(container);
    });
    
    // Bouton +
    var addBtn = document.createElement('button');
    addBtn.className = 'fcm-add-color-btn';
    addBtn.innerHTML = '<div class="fcm-add-color-inner"><svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M11 13H5V11H11V5H13V11H19V13H13V19H11V13Z" fill="white"/></svg></div>';
    addBtn.addEventListener('click', function(e) {
      e.preventDefault();
      e.stopPropagation();
      console.log('[FCM] Add button clicked');
      if (window.openColorPicker) {
        window.openColorPicker('fill-color-menu');
      }
    });
    wrapper.appendChild(addBtn);
    
    console.log('[FCM] Custom colors rendered, button added');
  }
  
  // Exposer pour le Color Picker
  window.fcmRenderCustomColors = renderCustomColors;

  function deleteCustomColor(index) {
    var colors = loadCustomColors();
    colors.splice(index, 1);
    saveCustomColors(colors);
    renderCustomColors();
    window.dispatchEvent(new CustomEvent('customColorAdded'));

  }

  function selectColor(color, element) {
    document.querySelectorAll('.fcm-color-swatch-container, .fcm-custom-color-container').forEach(function(el) {
      el.classList.remove('selected');
    });
    
    if (element) {
      element.classList.add('selected');
    }
    
    var indicator = document.getElementById('fill-color-indicator');
    if (indicator) {
      if (color === 'transparent') {
        indicator.style.background = 'white';
        indicator.innerHTML = '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#EF4444" stroke-width="2" style="display:block;margin:auto;"><line x1="3" y1="3" x2="21" y2="21"/><line x1="21" y1="3" x2="3" y2="21"/></svg>';
      } else {
        indicator.style.background = color;
        indicator.innerHTML = '';
      }
    }
    
    if (window.mapFunctions && window.mapFunctions.applyColorToSelected) {
      window.mapFunctions.applyColorToSelected(color);
    }
  }

  // Tabs
  document.querySelectorAll('.fcm-tab').forEach(function(tab) {
    tab.addEventListener('click', function() {
      document.querySelectorAll('.fcm-tab').forEach(function(t) { t.classList.remove('active'); });
      this.classList.add('active');
    });
  });

  // Type buttons
  document.querySelectorAll('.fcm-type-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      document.querySelectorAll('.fcm-type-btn').forEach(function(b) { b.classList.remove('active'); });
      this.classList.add('active');
    });
  });

  // Close button - simule un clic sur body pour que Bubble gère la fermeture
  document.getElementById('fcm-close-btn').addEventListener('click', function(e) {
    e.stopPropagation();
    
    // Fermer d'abord le color picker
    var panel = document.getElementById('custom-color-panel');
    if (panel) {
      panel.classList.remove('open');
      panel.style.display = 'none';
    }
    
    // Simuler un clic sur body pour fermer via Bubble (évite le bug double-clic)
    setTimeout(function() {
      var clickEvent = new MouseEvent('click', {
        bubbles: true,
        cancelable: true,
        view: window,
        clientX: 0,
        clientY: 0
      });
      document.body.dispatchEvent(clickEvent);
    }, 10);
  });

  // Observer pour fermer le Color Picker quand le FCM se ferme
  var fcmObserver = new MutationObserver(function(mutations) {
    mutations.forEach(function(mutation) {
      if (mutation.type === 'attributes') {
        var menu = document.getElementById('fill-color-menu');
        var groupFocus = menu ? menu.closest('[class*="group-focus"], [class*="GroupFocus"]') : null;
        
        if (groupFocus) {
          var isHidden = groupFocus.style.display === 'none' || 
                        window.getComputedStyle(groupFocus).display === 'none';
          
          if (isHidden) {
            var panel = document.getElementById('custom-color-panel');
            if (panel) {
              panel.classList.remove('open');
              panel.style.display = 'none';
            }
          }
        }
      }
    });
  });

  // Attacher l'observer au Group Focus parent
  setTimeout(function() {
    var menu = document.getElementById('fill-color-menu');
    var groupFocus = menu ? menu.closest('[class*="group-focus"], [class*="GroupFocus"]') : null;
    if (groupFocus) {
      fcmObserver.observe(groupFocus, { attributes: true, attributeFilter: ['style'] });
      console.log('[FCM] Observer attached to GroupFocus');
    }
  }, 100);
  
  // Écouter l'événement customColorAdded
  window.addEventListener('customColorAdded', function() {
    renderCustomColors();
  });

  // Init
  renderPalette();
  renderCustomColors();
  console.log('[FCM] ✓ Initialized');
})();
</script>
