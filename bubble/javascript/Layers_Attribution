    // ================================================
    // 2. FONCTION D'EXTRACTION (POUR GÉNÉRATION)
    // ================================================
    
    /**
     * Script à exécuter dans la console pour extraire l'attribution actuelle
     * et générer un fichier JSON à compléter manuellement.
     * 
     * UTILISATION:
     * 1. Charger toutes les layers sur la carte
     * 2. Exécuter window.generateAttribution() dans la console
     * 3. Copier le JSON résultant
     * 4. Compléter/corriger manuellement
     */
    window.generateAttribution = function() {
      const attribution = {
        lakes: {},
        rivers: {},
        regions: {},
        capitals: {}
      };
      
      // Extraire lakes
      document.querySelectorAll('.layer-lake').forEach(lake => {
        try {
          const data = d3.select(lake).datum();
          const name = data.properties.name;
          const country = lake.getAttribute('data-parent-country');
          if (name && country && country !== 'null') {
            attribution.lakes[name] = country;
          }
        } catch(e) {}
      });
      
      // Extraire rivers
      document.querySelectorAll('.layer-river').forEach(river => {
        try {
          const data = d3.select(river).datum();
          const name = data.properties.name;
          const country = river.getAttribute('data-parent-country');
          if (name && country && country !== 'null') {
            // Détecter rivières transfrontalières
            if (!attribution.rivers[name]) {
              attribution.rivers[name] = country;
            } else if (attribution.rivers[name] !== country) {
              // Convertir en array si multi-pays
              if (Array.isArray(attribution.rivers[name])) {
                if (!attribution.rivers[name].includes(country)) {
                  attribution.rivers[name].push(country);
                }
              } else {
                attribution.rivers[name] = [attribution.rivers[name], country];
              }
            }
          }
        } catch(e) {}
      });
      
      // Extraire regions
      document.querySelectorAll('.layer-region').forEach(region => {
        try {
          const data = d3.select(region).datum();
          const name = data.properties.name;
          const country = lake.getAttribute('data-parent-country');
          if (name && country && country !== 'null') {
            attribution.regions[name] = country;
          }
        } catch(e) {}
      });
      
      // Extraire capitals
      document.querySelectorAll('.layer-capital').forEach(capital => {
        try {
          const data = d3.select(capital).datum();
          const name = data.properties.name;
          const country = capital.getAttribute('data-parent-country');
          if (name && country && country !== 'null') {
            attribution.capitals[name] = country;
          }
        } catch(e) {}
      });
      
      console.log('📊 ATTRIBUTION GÉNÉRÉE:');
      console.log('  Lakes:', Object.keys(attribution.lakes).length);
      console.log('  Rivers:', Object.keys(attribution.rivers).length);
      console.log('  Regions:', Object.keys(attribution.regions).length);
      console.log('  Capitals:', Object.keys(attribution.capitals).length);
      console.log('\n📋 Copie ce JSON et complète-le manuellement:\n');
      console.log(JSON.stringify(attribution, null, 2));
      
      return attribution;
    };

    // ================================================
    // 3. FONCTION DE LOOKUP
    // ================================================
    
    /**
     * Récupère l'attribution d'un élément par son nom et type de layer
     * 
     * @param {string} name - Nom de l'élément (ex: "Lake Superior")
     * @param {string} layerType - Type de layer ('lakes', 'rivers', 'regions', 'capitals')
     * @returns {string|string[]|null} - Code ISO pays ou array de codes, ou null si pas trouvé
     */
    window.getManualAttribution = function(name, layerType) {
      if (!name || !layerType) return null;
      
      const attribution = window.LAYERS_ATTRIBUTION[layerType];
      if (!attribution) return null;
      
      return attribution[name] || null;
    };

    // ================================================
    // 4. FONCTION DE VALIDATION
    // ================================================
    
    /**
     * Valide l'intégrité du fichier d'attribution
     * Vérifie que les codes ISO sont corrects
     */
    window.validateAttribution = function() {
      const validIsoCodes = [
        'USA', 'CAN', 'MEX', 'BRA', 'ARG', 'PER', 'COL', 'VEN', 'CHL', 'ECU',
        'BOL', 'PRY', 'URY', 'GUY', 'SUR', 'FRA', 'DEU', 'GBR', 'ITA', 'ESP',
        'PRT', 'NLD', 'BEL', 'CHE', 'AUT', 'POL', 'CZE', 'HUN', 'ROU', 'BGR',
        'GRC', 'NOR', 'SWE', 'FIN', 'DNK', 'ISL', 'IRL', 'UKR', 'BLR', 'RUS',
        'CHN', 'JPN', 'IND', 'PAK', 'BGD', 'IDN', 'THA', 'VNM', 'PHL', 'MMR',
        'KOR', 'PRK', 'MYS', 'SGP', 'KHM', 'LAO', 'NPL', 'LKA', 'AFG', 'IRN',
        'IRQ', 'SAU', 'TUR', 'EGY', 'ZAF', 'NGA', 'ETH', 'KEN', 'TZA', 'UGA',
        'COD', 'SDN', 'DZA', 'MAR', 'AGO', 'MOZ', 'GHA', 'CMR', 'CIV', 'NER',
        'BFA', 'MLI', 'ZMB', 'SEN', 'SOM', 'TCD', 'ZWE', 'GIN', 'RWA', 'BEN',
        'TUN', 'SSD', 'TGO', 'SLE', 'LBY', 'LBR', 'MRT', 'NAM', 'GAB', 'BWA',
        'AUS', 'NZL', 'PNG', 'FJI', 'SLB', 'VUT', 'NCL', 'PYF', 'TKM', 'UZB',
        'KAZ', 'KGZ', 'TJK', 'MNG', 'AZE', 'ARM', 'GEO', 'EST', 'LVA', 'LTU',
        'SRB', 'HRV', 'SVN', 'BIH', 'MKD', 'ALB', 'MNE', 'XKX', 'SVK', 'ISR',
        'JOR', 'LBN', 'SYR', 'YEM', 'OMN', 'ARE', 'QAT', 'KWT', 'BHR', 'CYP'
      ];
      
      const errors = [];
      
      for (const layerType of ['lakes', 'rivers', 'regions', 'capitals']) {
        const attribution = window.LAYERS_ATTRIBUTION[layerType];
        
        for (const [name, country] of Object.entries(attribution)) {
          const countries = Array.isArray(country) ? country : [country];
          
          for (const code of countries) {
            if (!validIsoCodes.includes(code)) {
              errors.push(`❌ ${layerType} "${name}": code invalide "${code}"`);
            }
          }
        }
      }
      
      if (errors.length === 0) {
        console.log('✅ Attribution valide - tous les codes ISO sont corrects');
        return true;
      } else {
        console.error('⚠️ Erreurs détectées:');
        errors.forEach(err => console.error(err));
        return false;
      }
    };

    // ================================================
    // 5. STATISTIQUES
    // ================================================
    
    window.getAttributionStats = function() {
      const stats = {
        lakes: Object.keys(window.LAYERS_ATTRIBUTION.lakes).length,
        rivers: Object.keys(window.LAYERS_ATTRIBUTION.rivers).length,
        regions: Object.keys(window.LAYERS_ATTRIBUTION.regions).length,
        capitals: Object.keys(window.LAYERS_ATTRIBUTION.capitals).length
      };
      
      console.log('📊 STATISTIQUES ATTRIBUTION:');
      console.log(`  Lakes: ${stats.lakes} entrées`);
      console.log(`  Rivers: ${stats.rivers} entrées`);
      console.log(`  Regions: ${stats.regions} entrées`);
      console.log(`  Capitals: ${stats.capitals} entrées`);
      console.log(`  TOTAL: ${stats.lakes + stats.rivers + stats.regions + stats.capitals} entrées`);
      
      return stats;
    };

    // ================================================
    // AUTO-EXÉCUTION
    // ================================================
    
    console.log('✅ LAYERS_ATTRIBUTION chargé');
    console.log('📊 Entrées:', window.getAttributionStats());
    console.log('🔧 Commandes disponibles:');
    console.log('  - window.getManualAttribution(name, layerType)');
    console.log('  - window.generateAttribution() // Pour extraire auto');
    console.log('  - window.validateAttribution() // Valider codes ISO');
    console.log('  - window.getAttributionStats() // Statistiques');
